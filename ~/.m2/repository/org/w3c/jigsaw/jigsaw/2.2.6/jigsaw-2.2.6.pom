      <name>W3C Software License</name>
      <url>http://www.opensource.org/licenses/W3C.php</url>
      <distribution>repo</distribution>
    </license>
  </licenses>
  <developers>
    <developer>
      <id>w3c</id>
      <name>W3C</name>
      <email>www-jigsaw@w3.org</email>
    </developer>
  </developers>
</project>
