<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>org.w3c.jigsaw</groupId>
  <artifactId>jigsaw</artifactId>
  <version>2.2.6</version>
  <name>W3C Jigsaw</name>
  <description>Jigsaw is W3C's leading-edge Web server platform, providing a sample HTTP 1.1 implementation and a variety of other features on top of an advanced architecture implemented in Java.</description>
  <url>http://www.w3.org/Jigsaw/</url>
  <scm>
    <url>http://dev.w3.org/cvsweb</url>
    <connection>scm:cvs:pserver:anonymous@dev.w3.org:/sources/public</connection>
    <developerConnection>scm:cvs:pserver:username@dev.w3.org:/sources/public</developerConnection>
  </scm>
  <licenses>
